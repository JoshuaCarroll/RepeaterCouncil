{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch RepeaterCouncil.Web",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/RepeaterCouncil.Web/RepeaterCouncil.Web.csproj"
        },
        {
            "name": "Launch RepeaterCouncil.Web (Legacy)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/RepeaterCouncil.Web/bin/Debug/net9.0/RepeaterCouncil.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/RepeaterCouncil.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/RepeaterCouncil.Web/Views"
            }
        },
        {
            "name": "Attach to RepeaterCouncil.Web",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}