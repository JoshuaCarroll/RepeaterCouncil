@model RepeaterCouncil.Web.Models.EmailConfirmationViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Subject</title>
</head>

<body style='font-family: Arial, sans-serif; line-height: 1.6; color: #333;'>
    <div style='max-width: 600px; margin: 0 auto; padding: 20px;'>
        <h2 style='color: #0d6efd;'>Welcome to @Model.TenantName!</h2>

        <p>Hello <strong>@Model.FullName</strong>,</p>

        <p>Thank you for registering with @Model.TenantName. To complete your registration and activate your account,
            please confirm your email address by clicking the button below:</p>

        <div style='text-align: center; margin: 30px 0;'>
            <a href='@Model.CallbackUrl'
                style='display: inline-block; padding: 12px 30px; background-color: #0d6efd; color: white; text-decoration: none; border-radius: 5px; font-weight: bold;'>
                Confirm Email Address
            </a>
        </div>

        <p>If the button above doesn't work, you can also copy and paste this link into your browser:</p>
        <p style='word-break: break-all; color: #6c757d; font-size: 12px;'>@Model.CallbackUrl</p>

        <hr style='margin: 30px 0; border: none; border-top: 1px solid #eee;'>

        <p style='font-size: 12px; color: #6c757d;'>
            This email was sent to <strong>@Model.Email</strong> because you registered for an account with
            @Model.TenantName.
            <br>If you did not register for this account, please ignore this email.
        </p>

        <p style='font-size: 12px; color: #6c757d;'>
            <strong>@Model.TenantName</strong><br>
            Amateur Radio Repeater Coordination
        </p>
    </div>
</body>

</html>