@model RepeaterCouncil.Web.Models.AnnouncementEmailViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Subject</title>
</head>

<body style='font-family: Arial, sans-serif; line-height: 1.6; color: #333;'>
    <div style='max-width: 600px; margin: 0 auto; padding: 20px;'>
        <h2 style='color: #0d6efd;'>@Model.Subject</h2>

        @if (!string.IsNullOrEmpty(Model.RecipientName))
        {
            <p>Hello <strong>@Model.RecipientName</strong>,</p>
        }
        else
        {
            <p>Hello,</p>
        }

        @if (!string.IsNullOrEmpty(Model.PreMessage))
        {
            <p>@Html.Raw(Model.PreMessage)</p>
        }

        <div style='background-color: #f8f9fa; border-left: 4px solid #0d6efd; padding: 20px; margin: 20px 0;'>
            @Html.Raw(Model.MessageBody)
        </div>

        @if (!string.IsNullOrEmpty(Model.PostMessage))
        {
            <p>@Html.Raw(Model.PostMessage)</p>
        }

        @if (!string.IsNullOrEmpty(Model.ActionUrl) && !string.IsNullOrEmpty(Model.ActionText))
        {
            <div style='text-align: center; margin: 30px 0;'>
                <a href='@Model.ActionUrl'
                    style='display: inline-block; padding: 12px 30px; background-color: #0d6efd; color: white; text-decoration: none; border-radius: 5px; font-weight: bold;'>
                    @Model.ActionText
                </a>
            </div>
        }

        <hr style='margin: 30px 0; border: none; border-top: 1px solid #eee;'>

        <p style='font-size: 12px; color: #6c757d;'>
            This message was sent by <strong>@Model.TenantName</strong>.
            @if (!string.IsNullOrEmpty(Model.RecipientEmail))
            {
                <text><br>You received this email at <strong>@Model.RecipientEmail</strong>.</text>
            }
        </p>

        <p style='font-size: 12px; color: #6c757d;'>
            <strong>@Model.TenantName</strong><br>
            Amateur Radio Repeater Coordination
            @if (!string.IsNullOrEmpty(Model.SenderInfo))
            {
                <text><br>@Model.SenderInfo</text>
            }
        </p>
    </div>
</body>

</html>