@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend email confirmation";
}

<h1>@ViewData["Title"]</h1>
<h2>Enter your email to resend the confirmation email.</h2>

<div class="row">
    <div class="col-md-6">
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-heading">🔒 Email Confirmation Required</h4>
            <p><strong>Your account exists, but your email address hasn't been confirmed yet.</strong></p>
            <p>You must confirm your email address before you can log in and access your account.</p>
            <hr>
            <p class="mb-0">Enter your email address below to receive a new confirmation email.</p>
        </div>

        <form method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Resend Verification Email</button>
        </form>

        <div class="mt-4">
            <p><strong>Having trouble?</strong></p>
            <ul>
                <li>Make sure you're using the same email address you registered with</li>
                <li>Check your spam/junk folder for the original email</li>
                <li>Contact your repeater coordinator if you need assistance</li>
            </ul>
        </div>

        <hr class="mt-4">
        <p>
            <a asp-page="./Register" class="btn btn-outline-secondary">Register a New Account</a>
            <a asp-page="./Login" class="btn btn-outline-primary">Back to Login</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}