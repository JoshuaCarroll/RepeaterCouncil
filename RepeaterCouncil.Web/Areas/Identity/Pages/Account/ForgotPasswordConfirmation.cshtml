@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<h1>@ViewData["Title"]</h1>
<p>
    If an account with that email exists, we have sent you an email with instructions to reset your password.
</p>
<p>
    <strong>Please check your email</strong> (including your spam folder) for a password reset link.
</p>
<p>
    If you don't receive the email within a few minutes, please:
</p>
<ul>
    <li>Check your spam/junk folder</li>
    <li>Verify you entered the correct email address</li>
    <li>Try the reset process again</li>
    <li>Contact your repeater coordinator if you continue to have issues</li>
</ul>
<p>
    <a asp-page="./Login">Return to login</a>
</p>