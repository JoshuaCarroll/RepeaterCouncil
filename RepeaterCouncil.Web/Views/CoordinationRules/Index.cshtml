@model IEnumerable<RepeaterCouncil.Web.Models.CoordinationRule>

@{
    ViewData["Title"] = "Coordination Rules";
}

<h1>Coordination Rules</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tenant)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FrequencyStart)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FrequencyEnd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SpacingMHz)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SeparationMiles)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Tenant.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FrequencyStart)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FrequencyEnd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SpacingMHz)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SeparationMiles)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
