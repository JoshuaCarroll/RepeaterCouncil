@model RepeaterCouncil.Web.Models.CoordinationRule

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Coordination Rule</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="TenantId" class="control-label"></label>
                <select asp-for="TenantId" class ="form-control" asp-items="ViewBag.TenantId"></select>
                <span asp-validation-for="TenantId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FrequencyStart" class="control-label"></label>
                <input asp-for="FrequencyStart" class="form-control" />
                <span asp-validation-for="FrequencyStart" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FrequencyEnd" class="control-label"></label>
                <input asp-for="FrequencyEnd" class="form-control" />
                <span asp-validation-for="FrequencyEnd" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SpacingMHz" class="control-label"></label>
                <input asp-for="SpacingMHz" class="form-control" />
                <span asp-validation-for="SpacingMHz" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SeparationMiles" class="control-label"></label>
                <input asp-for="SeparationMiles" class="form-control" />
                <span asp-validation-for="SeparationMiles" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
