@model RepeaterCouncil.Web.Models.Tenant
@{
    ViewData["Title"] = "Tenant Content Management";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h2>Content Management</h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Content Management</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle me-2"></i>About Us Page
                    </h5>
                </div>
                <div class="card-body">
                    <p class="card-text">Manage the content that appears on your "About Us" page. This is where you can tell visitors about your repeater council, its history, and mission.</p>
                    @if (string.IsNullOrEmpty(Model.AboutUsContent))
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            No content has been set for the About Us page yet.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-check-circle me-2"></i>
                            About Us content is configured.
                        </div>
                    }
                    <a asp-action="EditAboutUs" class="btn btn-primary">
                        <i class="fas fa-edit me-2"></i>Edit About Us Content
                    </a>
                    <a asp-controller="Home" asp-action="About" class="btn btn-outline-secondary ms-2" target="_blank">
                        <i class="fas fa-eye me-2"></i>Preview Page
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-bar me-2"></i>Content Statistics
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-6">Tenant Name:</dt>
                        <dd class="col-sm-6">@Model.Name</dd>
                        
                        <dt class="col-sm-6">Website URL:</dt>
                        <dd class="col-sm-6">@Model.Url</dd>
                        
                        <dt class="col-sm-6">About Us Content:</dt>
                        <dd class="col-sm-6">
                            @if (string.IsNullOrEmpty(Model.AboutUsContent))
                            {
                                <span class="text-muted">Not configured</span>
                            }
                            else
                            {
                                <span class="text-success">@(Model.AboutUsContent.Length) characters</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>